'use client';

import { useState } from 'react';

export default function Home() {
  const [coins, setCoins] = useState(1);
  const [walletConnected, setWalletConnected] = useState(false);

  const connectWallet = () => {
    setWalletConnected(true);
  };

  return (
    <main style={{ padding: '20px', textAlign: 'center', background: '#0a0a0f', minHeight: '100vh', color: '#fff', fontFamily: 'sans-serif' }}>
      
      {/* Top Header */}
      <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '30px' }}>
        <span style={{ fontWeight: 'bold', fontSize: '18px' }}>Tap Mint</span>
        
        {/* Wallet Button */}
        <button 
          onClick={connectWallet}
          style={{ background: walletConnected ? '#00ffcc' : '#222', color: walletConnected ? '#000' : '#fff', border: '1px solid #444', padding: '8px 14px', borderRadius: '20px', fontSize: '12px', fontWeight: 'bold', cursor: 'pointer' }}
        >
          {walletConnected ? 'Connected ✅' : 'Connect Wallet'}
        </button>
      </div>

      {/* Balance Section */}
      <div style={{ fontSize: '14px', color: '#888', textTransform: 'uppercase', letterSpacing: '1px' }}>Balance</div>
      <div style={{ fontSize: '42px', fontWeight: 'bold', margin: '10px 0', color: '#ffcc00' }}>
        🪙 {coins}
      </div>

      {/* Big Tap Coin */}
      <div style={{ display: 'flex', justifyContent: 'center', margin: '40px 0' }}>
        <button 
          onClick={() => setCoins(c => c + 1)}
          style={{ width: '220px', height: '220px', borderRadius: '50%', background: 'linear-gradient(135deg, #ffd700, #ff9900)', border: 'none', fontSize: '64px', fontWeight: 'bold', color: '#fff', cursor: 'pointer', boxShadow: '0 0 30px rgba(255,215,0,0.4)' }}
        >
          B
        </button>
      </div>

      {/* Watch Ad Button */}
      <div style={{ marginTop: '30px' }}>
        <button 
          style={{ width: '100%', maxWidth: '350px', background: '#0070f3', color: '#fff', border: 'none', padding: '14px', borderRadius: '12px', fontSize: '16px', fontWeight: 'bold', cursor: 'pointer' }}
          onClick={() => alert('Ad watched! +500 coins added.')}
        >
          ▶ Watch Ad for +500 Coins
        </button>
      </div>

      <p style={{ fontSize: '12px', color: '#666', marginTop: '20px' }}>Tap the coin to earn 1 coin per tap</p>
    </main>
  );
}
